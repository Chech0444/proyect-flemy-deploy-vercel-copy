# ===================================================
# Configuración de la Plataforma de Cursos Online
# ===================================================
# Copiar este archivo como .env y modificar los valores

# Django
SECRET_KEY=chechox
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL
DB_NAME=courses_db
DB_USER=courses_user
DB_PASSWORD=courses_password123
DB_HOST=localhost
DB_PORT=5432

# Redis (Broker para Celery)
REDIS_URL=redis://localhost:6379/0

# Google Gemini API (Gratis)
# Obtén tu API key en: https://aistudio.google.com/apikey

# Whisper
# Modelos disponibles: tiny, base, small, medium, large
# tiny = más rápido, menos preciso | large = más lento, más preciso
WHISPER_MODEL=base
