DJANGO_SECRET_KEY=change-me
# AI Keys
GEMINI_API_KEY=api-key-gemini
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,https://proyect-flemy-deploy-vercel-copy.vercel.app
POSTGRES_DB=flemy
POSTGRES_USER=flemy
POSTGRES_PASSWORD=flemy
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://flemy:flemy@db:5432/flemy
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
USE_SQLITE=False
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@flemy.local
ADMIN_PASSWORD=Admin12345!
# Whisper - Modelos: tiny, base, small, medium, large
WHISPER_MODEL=base

# Email (Gmail SMTP - para recuperación de contraseña)
# Genera una contraseña de app en: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-clave-de-aplicacion
DEFAULT_FROM_EMAIL=Flemy <tu-correo@gmail.com>
