DJANGO_SECRET_KEY=change-me
# AI Keys
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
POSTGRES_DB=flemy
POSTGRES_USER=flemy
POSTGRES_PASSWORD=flemy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://flemy:flemy@localhost:5432/flemy
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_SQLITE=False
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@flemy.local
ADMIN_PASSWORD=Admin12345!
# Whisper - Modelos: tiny, base, small, medium, large
WHISPER_MODEL=base

# Email (Gmail SMTP - para recuperación de contraseña)
# Genera una contraseña de app en: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-clave-de-aplicacion
DEFAULT_FROM_EMAIL=Flemy <tu-correo@gmail.com>
